{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],

  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "github-actions",
    "pep621"
  ],

  "dockerfile": {
    "managerFilePatterns": ["/(^|/)docker/[^/]*\\.dockerfile$/"]
  },

  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  }
}
